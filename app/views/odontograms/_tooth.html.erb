<% tooth_number = local_assigns[:tooth_number] %>
<% sd = local_assigns[:state_data] || {} %>
<% w = 72 %>
<% h = 96 %>
<% vh = (h * 0.22).to_i %>
<% ph = (h * 0.22).to_i %>
<% oh = h - vh - ph %>
<% mw = (w * 0.28).to_i %>
<% dw = (w * 0.28).to_i %>
<% ow = w - mw - dw %>

<% whole = sd["whole"] %>
<% whole_state = whole ? whole[:state] : "healthy" %>
<% is_missing = whole_state == "missing" %>
<% is_implant = whole_state == "implant" %>
<% is_prosthesis = whole_state == "prosthesis" %>

<% face_labels = { vestibular: "V", mesial: "M", occlusal: "O/I", distal: "D", palatal: "P/L" } %>
<% face_titles = { vestibular: "Vestibular (externo)", mesial: "Mesial (hacia línea media)", occlusal: "Oclusal/Incisal (masticatorio)", distal: "Distal (fuera de línea media)", palatal: "Palatino/Lingual (interno)" } %>
<% face_coords = {
  vestibular: { cx: w/2, cy: vh/2 },
  mesial:     { cx: mw/2, cy: vh + oh/2 },
  occlusal:   { cx: mw + ow/2, cy: vh + oh/2 },
  distal:     { cx: mw + ow + dw/2, cy: vh + oh/2 },
  palatal:    { cx: w/2, cy: vh + oh + ph/2 }
} %>

<svg width="<%= w %>" height="<%= h %>" viewBox="0 0 <%= w %> <%= h %>"
     data-tooth="<%= tooth_number %>" class="tooth-svg">
  <rect x="0" y="0" width="<%= w %>" height="<%= h %>" rx="4" ry="4"
        fill="#fff" stroke="#999" stroke-width="1.2" class="tooth-outline" />

  <% if is_missing %>
    <rect x="0" y="0" width="<%= w %>" height="<%= h %>" rx="4" ry="4"
          fill="#495057" fill-opacity="0.35" stroke="#999" stroke-width="1.2" />
    <line x1="4" y1="4" x2="<%= w - 4 %>" y2="<%= h - 4 %>" stroke="#212529" stroke-width="2.5" />
    <line x1="<%= w - 4 %>" y1="4" x2="4" y2="<%= h - 4 %>" stroke="#212529" stroke-width="2.5" />
    <text x="<%= w / 2 %>" y="<%= h / 2 + 5 %>"
          text-anchor="middle" font-size="13" fill="#212529" font-weight="bold"
          class="tooth-state-letter">AUSENTE</text>
  <% elsif is_implant %>
    <rect x="0" y="0" width="<%= w %>" height="<%= h %>" rx="4" ry="4"
          fill="#198754" fill-opacity="0.2" stroke="#198754" stroke-width="2" />
    <text x="<%= w / 2 %>" y="<%= h / 2 + 6 %>"
          text-anchor="middle" font-size="18" fill="#198754" font-weight="bold"
          class="tooth-state-letter">I</text>
    <text x="<%= w / 2 %>" y="<%= h / 2 + 20 %>"
          text-anchor="middle" font-size="7" fill="#198754">Implante</text>
  <% elsif is_prosthesis %>
    <rect x="0" y="0" width="<%= w %>" height="<%= h %>" rx="4" ry="4"
          fill="#ffc107" fill-opacity="0.2" stroke="#ffc107" stroke-width="2" />
    <text x="<%= w / 2 %>" y="<%= h / 2 + 6 %>"
          text-anchor="middle" font-size="18" fill="#856404" font-weight="bold"
          class="tooth-state-letter">P</text>
    <text x="<%= w / 2 %>" y="<%= h / 2 + 20 %>"
          text-anchor="middle" font-size="7" fill="#856404">Prótesis</text>
  <% else %>
    <% { 
      vestibular: "M 0,0 L #{w},0 L #{w},#{vh} L 0,#{vh} Z",
      mesial:     "M 0,#{vh} L #{mw},#{vh} L #{mw},#{vh + oh} L 0,#{vh + oh} Z",
      occlusal:   "M #{mw},#{vh} L #{mw + ow},#{vh} L #{mw + ow},#{vh + oh} L #{mw},#{vh + oh} Z",
      distal:     "M #{mw + ow},#{vh} L #{w},#{vh} L #{w},#{vh + oh} L #{mw + ow},#{vh + oh} Z",
      palatal:    "M 0,#{vh + oh} L #{w},#{vh + oh} L #{w},#{h} L 0,#{h} Z"
    }.each do |face, d| %>
      <% 
        fs = sd[face.to_s]
        color = fs ? fs[:color] : nil
        coords = face_coords[face]
      %>
      <path d="<%= d %>"
            class="tooth-face tooth-face-<%= face %>"
            data-face="<%= face %>"
            data-tooth="<%= tooth_number %>"
            data-state="<%= fs ? fs[:state] : 'healthy' %>"
            data-action="click->odontogram#toggleFace"
            fill="<%= color || '#fff' %>"
            stroke="#bbb" stroke-width="1"
            stroke-dasharray="none"
            style="cursor: pointer;">
        <title><%= face_titles[face] %></title>
      </path>
      <text x="<%= coords[:cx] %>" y="<%= coords[:cy] + 4 %>"
            text-anchor="middle" font-size="9" font-weight="600"
            fill="<%= color ? '#fff' : '#888' %>"
            class="face-label face-label-<%= face %>"
            pointer-events="none"><%= face_labels[face] %></text>
    <% end %>
  <% end %>
  <text x="<%= w / 2 %>" y="<%= h - 4 %>"
        text-anchor="middle" font-size="8" fill="#555" font-weight="600"
        class="tooth-number-label"><%= tooth_number %></text>
</svg>

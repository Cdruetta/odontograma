<div class="container">
  <div style="display: flex; justify-content: space-between; align-items: center;">
    <h1>Pacientes</h1>
    <%= link_to "Nuevo", new_patient_path, class: "btn-action btn-action--new" %>
  </div>
  <table class="table">
    <thead>
      <tr>
        <th>Nombre</th>
        <th>Fecha Nac.</th>
        <th>Edad</th>
        <th>Teléfono</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% @patients.each do |patient| %>
        <tr>
          <td><%= link_to patient.name, patient %></td>
          <td><%= patient.birth_date %></td>
          <td><%= patient.age %></td>
          <td><%= patient.phone %></td>
          <td>
            <div class="table-actions">
              <%= link_to "Editar", edit_patient_path(patient), class: "btn-action btn-action--edit" %>
              <%= button_to "Eliminar", patient, method: :delete, data: { turbo_confirm: "¿Está seguro?" }, class: "btn-action btn-action--delete" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
